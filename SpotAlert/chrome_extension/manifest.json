{
  "manifest_version": 3,
  "name": "SpotAlert",
  "version": "0.3.2",
  "description": "Monitor supported website availability from a full-width Chrome dashboard.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "sidePanel",
    "scripting",
    "alarms",
    "notifications",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://thisisourdomain.securerc.co.uk/*",
    "https://southeast-thisisourdomain.securerc.co.uk/*",
    "https://api.resend.com/*",
    "https://canvas-world.securerc.co.uk/*",
    "https://www.canvas-world.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open SpotAlert",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://thisisourdomain.securerc.co.uk/*",
        "https://southeast-thisisourdomain.securerc.co.uk/*",
        "https://canvas-world.securerc.co.uk/*",
        "https://www.canvas-world.com/*"
      ],
      "js": [
        "website-popup.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
